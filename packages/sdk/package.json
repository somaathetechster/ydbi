{
  "name": "@ydbi/sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Shared types, API client, and utilities used across web, iOS bridge, and Android bridge",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.0"
  }
}