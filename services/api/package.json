{
  "name": "@ydbi/api",
  "version": "0.0.1",
  "private": true,
  "description": "YDBI API gateway, auth, butler orchestration, and service layer",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up -f database.json",
    "migrate:down": "node-pg-migrate down -f database.json",
    "migrate:create": "node-pg-migrate create -f database.json",
    "migrate:status": "node-pg-migrate status -f database.json"
  },
  "dependencies": {
    "fastify": "^4.26.2",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/websocket": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "pg": "^8.11.5",
    "node-pg-migrate": "^7.7.0",
    "redis": "^4.6.13",
    "zod": "^3.22.4",
    "dotenv": "^16.4.5",
    "bcryptjs": "^2.4.3",
    "@anthropic-ai/sdk": "^0.20.7",
    "openai": "^4.38.5"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.5",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.7.3"
  }
}